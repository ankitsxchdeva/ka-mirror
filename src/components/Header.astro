---
import { withBase } from '../lib/catalog.js';
---

<header transition:persist="ka-header">
  <div class="head-inner">
    <a class="wordmark" href={withBase('/')}>
      <span class="mark" aria-hidden="true">KA</span>
      <span class="name">Keycap Archivist</span>
      <span class="tag">mirror</span>
    </a>

    <div class="search" id="ka-search" role="search">
      <input
        id="ka-search-input"
        type="search"
        placeholder="Search makers, sculpts, colorways"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-label="Search the archive"
        aria-expanded="false"
        aria-controls="ka-search-panel"
        aria-autocomplete="list"
        aria-haspopup="listbox"
      />
      <kbd class="hint" aria-hidden="true">/</kbd>
      <div class="search-panel" id="ka-search-panel" role="listbox" hidden></div>
    </div>

    <a
      class="icon-btn"
      href="https://github.com/ankitsxchdeva/ka-mirror"
      title="Site source on GitHub"
      aria-label="Site source on GitHub"
      rel="noopener"
    >
      <!-- GitHub mark, via Simple Icons -->
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
    </a>

    <button
      class="icon-btn"
      id="theme-toggle"
      title="Toggle light/dark theme"
      aria-label="Toggle light/dark theme"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4" />
        <path d="M7 1.5 A5.5 5.5 0 0 0 7 12.5 Z" fill="currentColor" />
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .head-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 54px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .mark {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--bg);
    background: var(--ink);
    padding: 2px 5px;
    border-radius: 5px;
  }
  .name {
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }
  .tag {
    font-size: 0.6875rem;
    color: var(--ink-dim);
  }
  .search {
    position: relative;
    flex: 1;
    max-width: 440px;
    margin-left: auto;
  }
  .search input {
    width: 100%;
    padding-right: 34px;
    border-radius: 999px;
  }
  .hint {
    position: absolute;
    right: 10px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
  }
  .search input:focus ~ .hint {
    display: none;
  }
  .search-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    max-height: min(70vh, 540px);
    overflow-y: auto;
    background: var(--bg-panel);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px oklch(0.05 0 0 / 0.35);
  }
  .icon-btn {
    color: var(--ink-dim);
    padding: 6px;
    display: grid;
    place-items: center;
    transition: color var(--t);
  }
  .icon-btn:hover {
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .head-inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .name {
      display: none;
    }
    .search {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .hint {
      display: none;
    }
  }
</style>

<style is:global>
  .search-panel .sr-group {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    padding: 10px 12px 4px;
  }
  .search-panel .sr-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 12px;
    font-size: 0.8125rem;
    transition: background-color var(--t);
  }
  .search-panel .sr-row[data-active],
  .search-panel .sr-row:hover {
    background: var(--bg-hover);
  }
  .search-panel .sr-context {
    font-size: 0.75rem;
    color: var(--ink-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
  }
  .search-panel .sr-note {
    padding: 12px;
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }
</style>

<script>
  // ---- theme toggle -------------------------------------------------------
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'light'));
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    themeToggle.setAttribute('aria-pressed', String(light));
    localStorage.setItem('ka-theme', light ? 'light' : 'dark');
  });

  // ---- search -------------------------------------------------------------
  // Two lazily-fetched indexes: a light one (makers + sculpts, fetched on
  // focus) and the full colorway index (~70k entries, fetched on first
  // 2+ character query, cached by the browser afterwards).
  const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
  const input = document.getElementById('ka-search-input') as HTMLInputElement | null;
  const panel = document.getElementById('ka-search-panel');

  // "/" focuses search from anywhere.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable) return;
    e.preventDefault();
    input?.focus();
    input?.select();
  });

  // nl / kl are lowercased search keys, computed once after fetch.
  interface LightIndex {
    makers: { n: string; u: string; nl: string }[];
    sculpts: { n: string; m: string; u: string; kl: string }[];
  }
  interface CwIndex {
    sculpts: [string, string, string][];
    colorways: [number, string, string][];
  }

  let light: LightIndex | null = null;
  let cw: CwIndex | null = null;
  // Lowercased colorway names, parallel to cw.colorways.
  let cwNames: string[] | null = null;
  let lightLoading: Promise<void> | null = null;
  let cwLoading: Promise<void> | null = null;
  let lightFailed = false;
  let cwFailed = false;

  function loadLight() {
    lightLoading ??= fetch(`${BASE}/search-index.json`)
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((j) => {
        for (const m of j.makers) m.nl = m.n.toLowerCase();
        for (const s of j.sculpts) s.kl = `${s.m} ${s.n}`.toLowerCase();
        light = j;
        lightFailed = false;
      })
      .catch(() => {
        lightFailed = true;
        lightLoading = null; // allow retry on next keystroke
      });
    return lightLoading;
  }
  function loadCw() {
    cwLoading ??= fetch(`${BASE}/search-colorways.json`)
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((j) => {
        cwNames = j.colorways.map((c: [number, string, string]) => c[1].toLowerCase());
        cw = j;
        cwFailed = false;
      })
      .catch(() => {
        cwFailed = true;
        cwLoading = null;
      });
    return cwLoading;
  }

  /** Rank: exact = 3, prefix on any word = 2, substring = 1, none = 0. Expects a lowercased haystack. */
  function score(h: string, q: string): number {
    if (h === q) return 3;
    const i = h.indexOf(q);
    if (i < 0) return 0;
    return i === 0 || h[i - 1] === ' ' ? 2 : 1;
  }

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  }

  function hidePanel() {
    if (!panel) return;
    panel.hidden = true;
    input?.setAttribute('aria-expanded', 'false');
    input?.removeAttribute('aria-activedescendant');
  }

  function render(q: string) {
    if (!panel || !input) return;
    if (q.length < 2) {
      hidePanel();
      panel.innerHTML = '';
      return;
    }
    const ql = q.toLowerCase();
    let html = '';
    let opt = 0;

    if (light) {
      const makers = light.makers
        .map((m) => ({ s: score(m.nl, ql), m }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 5);
      const sculpts = light.sculpts
        .map((s) => ({ s: score(s.kl, ql), v: s }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 8);
      if (makers.length) {
        html += '<div class="sr-group" role="presentation">Makers</div>';
        for (const { m } of makers)
          html += `<a class="sr-row" role="option" id="sr-opt-${opt++}" href="${BASE}${m.u}">${esc(m.n)}</a>`;
      }
      if (sculpts.length) {
        html += '<div class="sr-group" role="presentation">Sculpts</div>';
        for (const { v } of sculpts)
          html += `<a class="sr-row" role="option" id="sr-opt-${opt++}" href="${BASE}${v.u}"><span>${esc(v.n)}</span><span class="sr-context">${esc(v.m)}</span></a>`;
      }
    }

    if (cw && cwNames) {
      const hits: { s: number; name: string; ctx: string; href: string }[] = [];
      for (let i = 0; i < cwNames.length; i++) {
        const sc = score(cwNames[i], ql);
        if (sc > 0) {
          const [si, name, id] = cw.colorways[i];
          const [sName, mName, url] = cw.sculpts[si];
          hits.push({
            s: sc,
            name,
            ctx: `${mName} / ${sName}`,
            href: `${BASE}${url}#${id}`,
          });
        }
      }
      hits.sort((a, b) => b.s - a.s);
      const top = hits.slice(0, 15);
      if (top.length) {
        html += '<div class="sr-group" role="presentation">Colorways</div>';
        for (const h of top)
          html += `<a class="sr-row" role="option" id="sr-opt-${opt++}" href="${h.href}"><span>${esc(h.name)}</span><span class="sr-context">${esc(h.ctx)}</span></a>`;
      }
    } else if (cwLoading) {
      html += '<div class="sr-note" role="status">Loading colorways…</div>';
    }

    if (!light && lightFailed) {
      html = '<div class="sr-note" role="status">Search is unavailable. Check your connection and type again to retry.</div>';
    } else if (!html) {
      html = '<div class="sr-note" role="status">No matches in the archive.</div>';
    }
    panel.innerHTML = html;
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    input.removeAttribute('aria-activedescendant');
  }

  let t: ReturnType<typeof setTimeout>;
  input?.addEventListener('focus', () => {
    loadLight();
    loadCw(); // preload the heavy index so the download overlaps typing
  });
  input?.addEventListener('input', () => {
    clearTimeout(t);
    t = setTimeout(async () => {
      const q = input.value.trim();
      if (q.length >= 2) {
        await loadLight();
        loadCw().then(() => render(input.value.trim()));
      }
      render(q);
    }, 120);
  });

  // keyboard: arrows move, enter follows, escape closes
  input?.addEventListener('keydown', (e) => {
    if (!panel || panel.hidden) return;
    const rows = [...panel.querySelectorAll<HTMLAnchorElement>('.sr-row')];
    if (!rows.length) return;
    const cur = rows.findIndex((r) => r.hasAttribute('data-active'));
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const next = e.key === 'ArrowDown' ? Math.min(cur + 1, rows.length - 1) : Math.max(cur - 1, 0);
      rows.forEach((r) => {
        r.removeAttribute('data-active');
        r.removeAttribute('aria-selected');
      });
      rows[next].setAttribute('data-active', '');
      rows[next].setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', rows[next].id);
      rows[next].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter' && cur >= 0) {
      e.preventDefault();
      rows[cur].click();
    } else if (e.key === 'Escape') {
      hidePanel();
    }
  });

  // Hide the panel when a result is clicked; the row's href may point at the
  // current page, in which case no navigation would close it for us.
  panel?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLAnchorElement>('.sr-row');
    if (!row) return;
    hidePanel();
    // Same-page hash link: Astro's router pushStates it without firing any
    // event, so the target page's hash listener never runs. Handle it here
    // and announce the change ourselves.
    if (row.hash && row.pathname === location.pathname) {
      e.preventDefault();
      history.pushState(history.state, '', row.hash);
      window.dispatchEvent(new HashChangeEvent('hashchange'));
    }
  });

  document.addEventListener('click', (e) => {
    if (panel && !document.getElementById('ka-search')?.contains(e.target as Node)) {
      hidePanel();
    }
  });

  // Close the results panel after a client-side navigation.
  document.addEventListener('astro:page-load', () => {
    hidePanel();
  });
</script>
