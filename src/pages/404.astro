---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/catalog.js';
---

<Base title="Not found">
  <div class="prose nf">
    <p class="sub">404</p>
    <h1 class="page-title">This page isn&rsquo;t in the archive.</h1>
    <p>
      It may have moved when the catalog was resynced.
      <a class="text-link" href={withBase('/')}>Browse the makers</a> or press <kbd>/</kbd> to search.
    </p>
  </div>
</Base>

<style>
  .nf {
    padding: 48px 0;
  }
  .nf .sub {
    margin: 0 0 6px;
  }
</style>
