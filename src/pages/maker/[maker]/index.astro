---
import Base from '../../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCatalog, withBase, img } from '../../../lib/catalog.js';

export async function getStaticPaths() {
  const { makers } = await getCatalog();
  return makers.map((maker) => ({
    params: { maker: maker.slug },
    props: { maker },
  }));
}

const { maker } = Astro.props;

const logoModules = import.meta.glob('../../../assets/logos/*.{jpg,png}', {
  eager: true,
});
const logo = Object.entries(logoModules).find(([p]) =>
  p.includes(`/${maker.id}.`)
)?.[1]?.default;

const links = [
  ['Website', maker.website],
  ['Instagram', maker.instagram],
  ['Discord', maker.discord],
].filter(([, url]) => url);
---

<Base
  title={maker.name}
  description={`${maker.name}: ${maker.sculpts.length} sculpts and ${maker.colorwayCount} artisan keycap colorways.`}
  ogImage={maker.cover ? img.large(maker.cover.id) : undefined}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={withBase('/')}>Makers</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{maker.name}</span>
  </nav>

  <div class="maker-head">
    {logo && (
      <span class="logo-box">
        <Image src={logo} alt="" width={112} height={112} />
      </span>
    )}
    <div>
      <h1 class="page-title">{maker.name}</h1>
      {links.length > 0 && (
        <p class="links">
          {links.map(([label, url]) => (
            <a class="text-link" href={url} rel="noopener">{label}</a>
          ))}
        </p>
      )}
    </div>
  </div>

  {
    maker.sculpts.length === 0 ? (
      <p class="empty">No sculpts catalogued for this maker yet.</p>
    ) : (
      <div class="grid">
        {maker.sculpts.map((s, i) => (
          <article class="card">
            <div class="card-img">
              {s.cover ? (
                <img
                  src={img.thumb(s.cover.id)}
                  alt=""
                  width="250"
                  height="250"
                  loading={i < 12 ? 'eager' : 'lazy'}
                  decoding="async"
                  data-cover-id={s.cover.id}
                />
              ) : (
                <div />
              )}
            </div>
            <div class="card-body">
              <a class="cover-link" href={withBase(s.url)}>
                <span class="card-name">{s.name}</span>
              </a>
              <span class="card-sub">
                {s.colorways.length} colorway{s.colorways.length === 1 ? '' : 's'}
              </span>
            </div>
          </article>
        ))}
      </div>
    )
  }
</Base>

<style>
  .maker-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
  }
  .logo-box {
    width: 56px;
    height: 56px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: oklch(0.97 0.004 250);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  :global(:root:not([data-theme='light'])) .logo-box {
    filter: brightness(0.85);
  }
  .logo-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .links {
    margin: 4px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.8125rem;
  }
</style>

<script>
  // If a 250px cover thumb is missing on the CDN, fall back to the original.
  const CDN = 'https://cdn.keycap-archivist.com/keycaps';

  function init() {
    const grid = document.querySelector<HTMLElement>('.grid');
    if (!grid || grid.dataset.fallbackBound) return;
    grid.dataset.fallbackBound = '1';
    grid.querySelectorAll<HTMLImageElement>('img[data-cover-id]').forEach((el) => {
      el.addEventListener(
        'error',
        () => {
          el.src = `${CDN}/${el.dataset.coverId}.jpg`;
        },
        { once: true }
      );
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
