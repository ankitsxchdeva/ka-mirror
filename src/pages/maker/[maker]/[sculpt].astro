---
import Base from '../../../layouts/Base.astro';
import { getCatalog, withBase, img } from '../../../lib/catalog.js';

export async function getStaticPaths() {
  const { makers } = await getCatalog();
  return makers.flatMap((maker) =>
    maker.sculpts.map((sculpt) => ({
      params: { maker: maker.slug, sculpt: sculpt.slug },
      props: { maker: { name: maker.name, slug: maker.slug, url: maker.url }, sculpt },
    }))
  );
}

const { maker, sculpt } = Astro.props;

// Everything the lightbox needs, keyed by colorway id. Image URLs are
// derived client-side from the id to keep large pages light.
const lightboxData = Object.fromEntries(
  sculpt.colorways.map((c) => [
    c.id,
    {
      name: c.name || 'Unnamed',
      releaseDate: c.releaseDate || null,
      totalCount: c.totalCount || null,
      note: c.note || null,
      photoCredit: c.photoCredit || null,
      commissioned: !!c.commissioned,
      giveaway: !!c.giveaway,
      stemType: Array.isArray(c.stemType) ? c.stemType.join(', ') : null,
    },
  ])
);
const many = sculpt.colorways.length > 24;
---

<Base
  title={`${sculpt.name} · ${maker.name}`}
  description={`${sculpt.name} by ${maker.name}: ${sculpt.colorways.length} artisan keycap colorways.`}
  ogImage={sculpt.cover ? img.large(sculpt.cover.id) : undefined}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={withBase('/')}>Makers</a>
    <span aria-hidden="true">/</span>
    <a href={withBase(maker.url)}>{maker.name}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{sculpt.name}</span>
  </nav>

  <div class="head-row">
    <h1 class="page-title">{sculpt.name}</h1>
    {many && (
      <input id="cw-filter" type="text" placeholder="Filter colorways" aria-label="Filter colorways" />
    )}
  </div>

  <div class="grid">
    {
      sculpt.colorways.map((c, i) => (
        <article class="card" id={c.id} data-name={(c.name || 'unnamed').toLowerCase()}>
          <a class="cw-open" href={`#${c.id}`} data-cw={c.id} aria-label={`View ${c.name || 'unnamed colorway'}`}>
            <span class="card-img">
              <img
                src={img.thumb(c.id)}
                alt={c.name || 'Unnamed colorway'}
                width="250"
                height="250"
                loading={i < 12 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
              />
            </span>
            <span class="card-body">
              <span class="card-name">{c.name || 'Unnamed'}</span>
              {c.releaseDate && <span class="card-sub">{c.releaseDate}</span>}
            </span>
          </a>
        </article>
      ))
    }
  </div>
  <p class="empty" id="no-match" hidden>No colorways match that filter.</p>

  <dialog id="lightbox" autofocus aria-labelledby="lb-name">
    <div class="lb-frame">
      <img id="lb-img" alt="" />
    </div>
    <div class="lb-side">
      <p class="sub">{maker.name} / {sculpt.name}</p>
      <h2 id="lb-name" aria-live="polite"></h2>
      <dl id="lb-meta"></dl>
      <div class="lb-actions">
        <button id="lb-copy" class="quiet-action">Copy link</button>
        <a id="lb-full" class="text-link" target="_blank" rel="noopener">Full image</a>
      </div>
      <div class="lb-nav">
        <button id="lb-prev" class="quiet-action" aria-label="Previous colorway">Prev</button>
        <button id="lb-next" class="quiet-action" aria-label="Next colorway">Next</button>
        <button id="lb-close" class="quiet-action" aria-label="Close">Close</button>
        <span class="lb-hint" aria-hidden="true"><kbd>←</kbd> <kbd>→</kbd> <kbd>esc</kbd></span>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="cw-data" set:html={JSON.stringify(lightboxData)} />
</Base>

<style>
  .cw-open {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  dialog#lightbox {
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--bg); /* canonical popover: page-bg surface */
    color: var(--ink);
    padding: 0;
    width: min(920px, calc(100vw - 24px));
    max-height: calc(100dvh - 40px);
    display: none;
    grid-template-columns: 1.5fr 1fr;
    overflow: hidden;
  }
  dialog#lightbox[open] {
    display: grid;
  }
  dialog#lightbox::backdrop {
    background: var(--overlay);
  }
  .lb-frame {
    background: var(--bg-inset);
    display: grid;
    place-items: center;
    min-height: 300px;
  }
  .lb-frame img {
    width: 100%;
    height: 100%;
    max-height: calc(100dvh - 40px);
    object-fit: contain;
  }
  .lb-side {
    padding: 18px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lb-side h2 {
    font-size: 0.875rem; /* title tier */
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }
  .lb-side p {
    margin: 0;
  }
  #lb-meta {
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    font-size: 0.8125rem;
  }
  #lb-meta :global(dt) {
    color: var(--ink-dim);
  }
  #lb-meta :global(dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .lb-actions {
    display: flex;
    gap: 14px;
    margin-top: 12px;
    font-size: 0.8125rem;
  }
  /* canonical quiet action: meta tier, muted; hover accent-hover; active accent */
  .quiet-action {
    font-size: 0.6875rem;
    color: var(--ink-mid);
    transition: color var(--t);
  }
  .quiet-action:hover {
    color: var(--accent-hover);
  }
  .quiet-action:active {
    color: var(--accent);
  }
  .lb-nav {
    margin-top: auto;
    padding-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 0.8125rem;
  }
  .lb-hint {
    margin-left: auto;
    display: inline-flex;
    gap: 4px;
  }
  @media (max-width: 700px) {
    dialog#lightbox[open] {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .lb-frame img {
      max-height: 52dvh;
    }
    .lb-hint {
      display: none;
    }
    .lb-actions button,
    .lb-actions a,
    .lb-nav button {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 4px;
    }
  }
</style>

<script>
  // Re-runs on every client-side navigation (astro:page-load); all state and
  // element refs are scoped inside init() against the current DOM.
  const CDN = 'https://cdn.keycap-archivist.com/keycaps';

  // Window listeners outlive client-side navigations, so each init() aborts
  // the previous page's listeners before registering its own.
  let hashAbort: AbortController | null = null;
  // Latest page's hash-opener; re-invoked after every router navigation
  // because same-page hash links fire astro:page-load without re-initing.
  let currentOpenFromHash: (() => void) | null = null;

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  }

  function init() {
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (!dialog || dialog.dataset.bound) return;
  dialog.dataset.bound = '1';
  hashAbort?.abort();
  const hashCtrl = new AbortController();
  hashAbort = hashCtrl;

  const data = JSON.parse(document.getElementById('cw-data')!.textContent!) as Record<
    string,
    {
      name: string;
      releaseDate: string | null;
      totalCount: number | null;
      note: string | null;
      photoCredit: string | null;
      commissioned: boolean;
      giveaway: boolean;
      stemType: string | null;
    }
  >;
  // Gallery path, captured before the lightbox ever rewrites the URL. While
  // a colorway is open the address bar shows its share-page URL
  // (…/<sculpt>/<id>/), so copying from the address bar — not just the Copy
  // link button — produces a link that unfurls the right photo.
  const galleryPath = location.pathname.replace(/\/+$/, '') + '/';
  const ids = Object.keys(data);
  const $ = (id: string) => document.getElementById(id)!;
  let current = '';

  function show(id: string) {
    const c = data[id];
    if (!c) return;
    current = id;
    const full = `${CDN}/${id}.jpg`;
    const imgEl = $('lb-img') as HTMLImageElement;
    imgEl.src = `${CDN}/720/${id}.jpg`;
    imgEl.onerror = () => {
      imgEl.onerror = null;
      imgEl.src = full;
    };
    imgEl.alt = c.name;
    $('lb-name').textContent = c.name;
    ($('lb-full') as HTMLAnchorElement).href = full;

    const rows: [string, string][] = [];
    if (c.releaseDate) rows.push(['Released', c.releaseDate]);
    if (c.totalCount) rows.push(['Made', String(c.totalCount)]);
    if (c.stemType) rows.push(['Stem', c.stemType]);
    if (c.commissioned) rows.push(['Type', 'Commissioned']);
    if (c.giveaway) rows.push(['Type', 'Giveaway']);
    if (c.photoCredit) rows.push(['Photo', c.photoCredit]);
    if (c.note) rows.push(['Note', c.note]);
    $('lb-meta').innerHTML = rows
      .map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`)
      .join('');

    // Preserve the router's history state; replacing it with null corrupts
    // Astro ClientRouter forward/back navigation.
    history.replaceState(history.state, '', `${galleryPath}${id}/`);
    if (!dialog.open) dialog.showModal();

    // warm the neighbors so prev/next feel instant
    const i = ids.indexOf(id);
    for (const n of [ids[i + 1], ids[i - 1]]) {
      if (n) new Image().src = `${CDN}/720/${n}.jpg`;
    }
  }

  function close() {
    if (dialog.open) dialog.close();
  }
  dialog.addEventListener('close', () => {
    history.replaceState(history.state, '', galleryPath);
    // Deep-link and hashchange opens have no invoker for the browser to
    // restore focus to; send it back to the current colorway's card link.
    if (!document.activeElement || document.activeElement === document.body) {
      document
        .getElementById(current)
        ?.querySelector<HTMLAnchorElement>('a.cw-open')
        ?.focus();
    }
  });

  function step(delta: number) {
    // Step through visible cards only so Prev/Next respect the filter.
    const visible = ids.filter((id) => !document.getElementById(id)?.hidden);
    if (!visible.length) return;
    const i = visible.indexOf(current);
    if (i < 0) {
      show(visible[0]);
      return;
    }
    show(visible[(i + delta + visible.length) % visible.length]);
  }

  // Cards are anchor links so no-JS visitors still get a :target jump;
  // with JS we intercept and open the lightbox instead.
  document.querySelectorAll<HTMLAnchorElement>('.cw-open').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(a.dataset.cw!);
    })
  );
  $('lb-close').addEventListener('click', close);
  $('lb-prev').addEventListener('click', () => step(-1));
  $('lb-next').addEventListener('click', () => step(1));
  $('lb-copy').addEventListener('click', async () => {
    // Copy the per-colorway share page URL (correct og:image in previews),
    // not the #hash URL, whose fragment crawlers never see.
    const shareUrl = `${location.origin}${galleryPath}${current}/`;
    const ok = await navigator.clipboard
      .writeText(shareUrl)
      .then(() => true)
      .catch(() => {
        // clipboard API can be unavailable (permissions, http); fall back
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        document.body.appendChild(ta);
        ta.select();
        const done = document.execCommand('copy');
        ta.remove();
        return done;
      });
    $('lb-copy').textContent = ok ? 'Copied' : 'Copy failed';
    setTimeout(() => ($('lb-copy').textContent = 'Copy link'), 1500);
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // If a 250px thumb is missing on the CDN, fall back to the original image.
  document.querySelectorAll<HTMLImageElement>('.card-img img').forEach((el) => {
    el.addEventListener(
      'error',
      () => {
        const id = el.closest('.card')?.id;
        if (id) el.src = `${CDN}/${id}.jpg`;
      },
      { once: true }
    );
  });

  // Inline filter (rendered only for galleries over 24 colorways).
  const filter = document.getElementById('cw-filter') as HTMLInputElement | null;
  if (filter) {
    const noMatch = document.getElementById('no-match')!;
    filter.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let any = false;
      document.querySelectorAll<HTMLElement>('.card[data-name]').forEach((p) => {
        const hit = !q || p.dataset.name!.includes(q) || p.id.includes(q);
        p.hidden = !hit;
        if (hit) any = true;
      });
      noMatch.hidden = any;
    });
  }

  // Deep link: /maker/x/sculpt#<colorwayId> opens the lightbox directly.
  function openFromHash() {
    const hash = location.hash.slice(1);
    if (hash && data[hash]) {
      document.getElementById(hash)?.scrollIntoView({ block: 'nearest' });
      show(hash);
    }
  }
  openFromHash();
  // Search results pointing at the current page only change the hash. Direct
  // URL edits fire hashchange, but Astro's router intercepts link clicks and
  // uses pushState (no hashchange), so we also re-check the hash on every
  // astro:page-load below. The controller's signal drops the stale listener
  // when a client-side navigation re-runs init().
  window.addEventListener('hashchange', openFromHash, { signal: hashCtrl.signal });
  currentOpenFromHash = openFromHash;
  }

  init();
  document.addEventListener('astro:page-load', () => {
    init();
    currentOpenFromHash?.();
  });
</script>
