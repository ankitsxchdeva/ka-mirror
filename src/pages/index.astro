---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCatalog, withBase, img } from '../lib/catalog.js';

const { makers, stats } = await getCatalog();

// Maker logos vendored from the original site, keyed by maker id.
const logoModules = import.meta.glob('../assets/logos/*.{jpg,png}', {
  eager: true,
});
const logos = Object.fromEntries(
  Object.entries(logoModules).map(([p, mod]) => [
    p.split('/').pop().replace(/\.(jpg|png)$/, ''),
    mod.default,
  ])
);

const fmt = (n) => n.toLocaleString('en-US');

const letterOf = (name) => {
  const c = name[0].toUpperCase();
  return c >= 'A' && c <= 'Z' ? c : '0-9';
};
const groups = [];
for (const m of makers) {
  const letter = letterOf(m.name);
  if (!groups.length || groups[groups.length - 1].letter !== letter) {
    groups.push({ letter, makers: [] });
  }
  groups[groups.length - 1].makers.push(m);
}
---

<Base>
  <div class="toolbar">
    <div>
      <h1 class="page-title">Maker index</h1>
      <p class="mono-dim stats">
        {fmt(stats.makers)} makers / {fmt(stats.sculpts)} sculpts / {fmt(stats.colorways)} colorways,
        synced daily from the makers&rsquo; own catalogs
      </p>
    </div>
    <input id="maker-filter" type="text" placeholder="filter makers" aria-label="Filter makers" />
  </div>

  <table class="index" id="maker-index">
    <thead>
      <tr>
        <th class="thumb-cell"><span class="visually-hidden">Logo</span></th>
        <th>Maker</th>
        <th class="origin-col">Origin</th>
        <th class="num">Sculpts</th>
        <th class="num">Colorways</th>
        <th class="pin-col"><span class="visually-hidden">Pin</span></th>
      </tr>
    </thead>
    <tbody id="pinned-group" hidden>
      <tr class="group-head"><td colspan="6" id="letter-pinned">pinned</td></tr>
    </tbody>
    {
      groups.map((g) => (
        <tbody data-letter={g.letter}>
          <tr class="group-head">
            <td colspan="6" id={`letter-${g.letter}`}>{g.letter}</td>
          </tr>
          {g.makers.map((m, i) => (
            <tr
              data-maker-id={m.id}
              data-name={m.name.toLowerCase()}
              data-letter={g.letter}
              data-preview={m.cover ? img.thumb(m.cover.id) : undefined}
            >
              <td class="thumb-cell">
                {logos[m.id] ? (
                  <Image src={logos[m.id]} alt="" width={56} height={56} quality={70} loading="lazy" />
                ) : m.cover ? (
                  <img src={img.thumb(m.cover.id)} alt="" width="28" height="28" loading="lazy" decoding="async" />
                ) : (
                  <span class="no-logo" aria-hidden="true" />
                )}
              </td>
              <td>
                <a class="row-link" href={withBase(m.url)}>{m.name}</a>
              </td>
              <td class="origin-col mono-dim">{m.nationality ? m.nationality.toUpperCase() : ''}</td>
              <td class="num">{m.sculpts.length}</td>
              <td class="num">{fmt(m.colorwayCount)}</td>
              <td class="pin-col">
                <button
                  class="pin above-link"
                  data-star={m.id}
                  title={`Pin ${m.name} to the top`}
                  aria-label={`Pin ${m.name} to the top`}
                  aria-pressed="false"
                >★</button>
              </td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
  <p class="empty" id="no-match" hidden>no makers match that filter</p>

  <nav class="rail" aria-label="Jump to letter">
    {groups.map((g) => <a href={`#letter-${g.letter}`}>{g.letter === '0-9' ? '#' : g.letter}</a>)}
  </nav>
</Base>

<style>
  .stats {
    margin: 4px 0 0;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .no-logo {
    display: block;
    width: 28px;
    height: 28px;
    background: var(--bg-inset);
  }
  .pin-col {
    width: 34px;
    text-align: right;
  }
  .rail {
    position: fixed;
    right: 6px;
    top: 50%;
    translate: 0 -50%;
    display: none;
    flex-direction: column;
    gap: 1px;
  }
  .rail a {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--ink-dim);
    padding: 1px 6px;
    text-align: center;
    transition: color var(--t);
  }
  .rail a:hover {
    color: var(--accent);
  }
  @media (min-width: 1330px) {
    .rail {
      display: flex;
    }
  }
  @media (max-width: 620px) {
    .origin-col {
      display: none;
    }
  }
</style>

<script>
  import { initRowPreview } from '../scripts/row-preview.js';
  initRowPreview();

  // ---- pinned makers (localStorage), shown as a group at the top ----------
  const KEY = 'ka-pinned-makers';
  const table = document.getElementById('maker-index')!;
  const pinnedBody = document.getElementById('pinned-group') as HTMLTableSectionElement;
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  const homeOf = new Map<string, { body: HTMLTableSectionElement; next: () => Element | null }>();
  table.querySelectorAll<HTMLTableRowElement>('tr[data-maker-id]').forEach((row) => {
    const body = row.parentElement as HTMLTableSectionElement;
    const name = row.dataset.name!;
    homeOf.set(row.dataset.makerId!, {
      body,
      // alphabetical re-insertion point when un-pinning
      next: () =>
        [...body.querySelectorAll<HTMLTableRowElement>('tr[data-maker-id]')].find(
          (r) => r.dataset.name! > name
        ) ?? null,
    });
  });

  function apply(pinned: string[]) {
    // restore any un-pinned rows first
    [...pinnedBody.querySelectorAll<HTMLTableRowElement>('tr[data-maker-id]')].forEach((row) => {
      if (!pinned.includes(row.dataset.makerId!)) {
        const home = homeOf.get(row.dataset.makerId!)!;
        home.body.insertBefore(row, home.next());
      }
    });
    for (const id of pinned) {
      const row = table.querySelector(`tr[data-maker-id="${id}"]`);
      if (row) pinnedBody.appendChild(row);
    }
    pinnedBody.hidden = pinned.length === 0;
    table.querySelectorAll<HTMLButtonElement>('[data-star]').forEach((b) => {
      b.setAttribute('aria-pressed', String(pinned.includes(b.dataset.star!)));
    });
  }

  apply(read());

  table.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-star]');
    if (!btn) return;
    const id = btn.dataset.star!;
    let pinned = read();
    pinned = pinned.includes(id) ? pinned.filter((x) => x !== id) : [...pinned, id];
    localStorage.setItem(KEY, JSON.stringify(pinned));
    apply(pinned);
  });

  // ---- inline filter ------------------------------------------------------
  const filter = document.getElementById('maker-filter') as HTMLInputElement;
  const noMatch = document.getElementById('no-match')!;
  filter.addEventListener('input', () => {
    const q = filter.value.trim().toLowerCase();
    let any = false;
    table.querySelectorAll<HTMLTableRowElement>('tr[data-maker-id]').forEach((row) => {
      const hit = !q || row.dataset.name!.includes(q);
      row.hidden = !hit;
      if (hit) any = true;
    });
    table.querySelectorAll<HTMLTableSectionElement>('tbody').forEach((body) => {
      const rows = body.querySelectorAll('tr[data-maker-id]');
      if (!rows.length) return;
      (body.querySelector('.group-head') as HTMLElement).hidden =
        ![...rows].some((r) => !(r as HTMLTableRowElement).hidden);
    });
    noMatch.hidden = any;
  });
</script>
