---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCatalog, withBase, img } from '../lib/catalog.js';
import logoManifest from '../assets/logos-processed/manifest.json';

const { makers } = await getCatalog();

// Background-removed maker logos (scripts/process-logos.mjs), keyed by id.
// Dark-ink logos are flagged `chip` and rendered on a light tile.
const logoModules = import.meta.glob('../assets/logos-processed/*.png', {
  eager: true,
});
const logos = Object.fromEntries(
  Object.entries(logoModules).map(([p, mod]) => [
    p.split('/').pop().replace('.png', ''),
    mod.default,
  ])
);
---

<Base>
  <h1 class="visually-hidden">Makers</h1>
  <div class="grid" id="maker-grid">
    {
      makers.map((m) => (
        <article class="card" data-maker-id={m.id}>
          <div class:list={['card-img', logos[m.id] && 'logo-tile', logoManifest[m.id]?.chip && 'chip']}>
            {logos[m.id] ? (
              <Image src={logos[m.id]} alt="" width={240} height={240} loading="lazy" />
            ) : m.cover ? (
              <img src={img.thumb(m.cover.id)} alt="" width="240" height="240" loading="lazy" decoding="async" />
            ) : (
              <div />
            )}
          </div>
          <div class="card-body">
            <a class="cover-link" href={withBase(m.url)}>
              <span class="card-name">{m.name}</span>
            </a>
            <span class="card-sub">
              {m.sculpts.length} sculpt{m.sculpts.length === 1 ? '' : 's'}
            </span>
          </div>
          <button
            class="pin above-link"
            data-star={m.id}
            title={`Pin ${m.name} to the top`}
            aria-label={`Pin ${m.name} to the top`}
            aria-pressed="false"
          >★</button>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>

<script>
  // Pinned makers (localStorage): pinned cards move to the front of the grid.
  const KEY = 'ka-pinned-makers';
  const grid = document.getElementById('maker-grid');
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  const original = grid ? [...grid.children] : [];

  function apply(pinned: string[]) {
    if (!grid) return;
    // restore original order, then move pinned to front in pin order
    original.forEach((c) => grid.appendChild(c));
    for (const id of [...pinned].reverse()) {
      const card = grid.querySelector(`[data-maker-id="${id}"]`);
      if (card) grid.prepend(card);
    }
    grid.querySelectorAll<HTMLButtonElement>('[data-star]').forEach((b) => {
      b.setAttribute('aria-pressed', String(pinned.includes(b.dataset.star!)));
    });
  }

  apply(read());

  grid?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-star]');
    if (!btn) return;
    const id = btn.dataset.star!;
    let pinned = read();
    pinned = pinned.includes(id) ? pinned.filter((x) => x !== id) : [...pinned, id];
    localStorage.setItem(KEY, JSON.stringify(pinned));
    apply(pinned);
  });
</script>
