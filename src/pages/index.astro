---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCatalog, withBase } from '../lib/catalog.js';

const { makers } = await getCatalog();

// Maker logos as published (white backgrounds), keyed by id. Dark mode dims
// the tile slightly so the white ground reads as a soft grey.
const logoModules = import.meta.glob('../assets/logos/*.{jpg,png}', {
  eager: true,
});
const logos = Object.fromEntries(
  Object.entries(logoModules).map(([p, mod]) => [
    p.split('/').pop().replace(/\.(jpg|png)$/, ''),
    mod.default,
  ])
);
---

<Base description="Browse artisan keycap makers, sculpts, and colorways.">
  <section id="pinned-section" hidden>
    <h2 class="sub group-label">Pinned</h2>
    <div class="grid" id="pinned-grid"></div>
  </section>
  <div class="grid-head">
    <h1 class="sub group-label">Makers</h1>
    <select id="maker-sort" aria-label="Sort makers">
      <option value="az">A-Z</option>
      <option value="za">Z-A</option>
      <option value="sculpts-desc">Most sculpts</option>
      <option value="sculpts-asc">Fewest sculpts</option>
      <option value="cw-desc">Most colorways</option>
      <option value="cw-asc">Fewest colorways</option>
    </select>
  </div>
  <div class="grid" id="maker-grid">
    {
      makers.map((m, i) => (
        <article
          class="card"
          data-maker-id={m.id}
          data-name={m.name.toLowerCase()}
          data-sculpts={m.sculpts.length}
          data-colorways={m.colorwayCount}
        >
          <div class="card-img logo-tile">
            {logos[m.id] ? (
              <Image
                src={logos[m.id]}
                alt=""
                width={240}
                height={240}
                loading={i < 12 ? 'eager' : 'lazy'}
              />
            ) : (
              /* the ⃠ mark, drawn as SVG so it renders identically everywhere */
              <svg class="no-logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="2.5" />
                <path d="M12 12 L36 36" stroke="currentColor" stroke-width="2.5" />
              </svg>
            )}
          </div>
          <div class="card-body">
            <a class="cover-link" href={withBase(m.url)}>
              <span class="card-name">{m.name}</span>
            </a>
            <span class="card-sub">
              {`${m.sculpts.length} sculpt${m.sculpts.length === 1 ? '' : 's'} / ${m.colorwayCount.toLocaleString('en-US')} colorway${m.colorwayCount === 1 ? '' : 's'}`}
            </span>
          </div>
          <button
            class="pin above-link"
            data-star={m.id}
            title={`Pin ${m.name} to the top`}
            aria-label={`Pin ${m.name} to the top`}
            aria-pressed="false"
          >★</button>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .no-logo {
    width: 44px;
    height: 44px;
    color: var(--ink-dim);
  }
  #pinned-section {
    margin-bottom: 20px;
  }
  .group-label {
    font-weight: 400;
    margin: 0 0 8px;
  }
  .grid-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .grid-head .group-label {
    margin: 0;
  }
</style>

<script>
  // Pinned makers (localStorage) live in their own section above the main
  // grid; the sort select orders the main grid. Both persist. Re-runs on
  // every client-side navigation (astro:page-load), so all state is derived
  // from the current DOM inside init().
  const KEY = 'ka-pinned-makers';
  const SORT_KEY = 'ka-sort';
  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  type Card = HTMLElement;
  const comparators: Record<string, (a: Card, b: Card) => number> = {
    az: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!, 'en'),
    za: (a, b) => b.dataset.name!.localeCompare(a.dataset.name!, 'en'),
    'sculpts-desc': (a, b) => +b.dataset.sculpts! - +a.dataset.sculpts! || comparators.az(a, b),
    'sculpts-asc': (a, b) => +a.dataset.sculpts! - +b.dataset.sculpts! || comparators.az(a, b),
    'cw-desc': (a, b) => +b.dataset.colorways! - +a.dataset.colorways! || comparators.az(a, b),
    'cw-asc': (a, b) => +a.dataset.colorways! - +b.dataset.colorways! || comparators.az(a, b),
  };
  const readSort = (): string => {
    const s = localStorage.getItem(SORT_KEY) ?? 'az';
    return s in comparators ? s : 'az';
  };

  function init() {
    const grid = document.getElementById('maker-grid');
    const section = document.getElementById('pinned-section');
    const pinnedGrid = document.getElementById('pinned-grid');
    const sortSel = document.getElementById('maker-sort') as HTMLSelectElement | null;
    if (!grid || !section || !pinnedGrid || !sortSel || grid.dataset.bound) return;
    grid.dataset.bound = '1';

    const cards = [...grid.children] as Card[];

    function apply(pinned: string[]) {
      // Sort all cards into the main grid, then pull pinned cards (in pin
      // order) into the pinned grid.
      const sorted = [...cards].sort(comparators[readSort()]);
      sorted.forEach((c) => grid!.appendChild(c));
      for (const id of pinned) {
        const card = grid!.querySelector(`[data-maker-id="${id}"]`);
        if (card) pinnedGrid!.appendChild(card);
      }
      section!.hidden = pinnedGrid!.children.length === 0;
      document.querySelectorAll<HTMLButtonElement>('[data-star]').forEach((b) => {
        b.setAttribute('aria-pressed', String(pinned.includes(b.dataset.star!)));
      });
    }

    sortSel.value = readSort();
    apply(read());

    sortSel.addEventListener('change', () => {
      localStorage.setItem(SORT_KEY, sortSel.value);
      apply(read());
    });

    const onStarClick = (e: Event) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-star]');
      if (!btn) return;
      const id = btn.dataset.star!;
      let pinned = read();
      pinned = pinned.includes(id) ? pinned.filter((x) => x !== id) : [...pinned, id];
      localStorage.setItem(KEY, JSON.stringify(pinned));
      apply(pinned);
    };
    grid.addEventListener('click', onStarClick);
    pinnedGrid.addEventListener('click', onStarClick);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
