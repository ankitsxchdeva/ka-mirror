---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import { withBase } from '../lib/catalog.js';

const { title, description, ogImage } = Astro.props;
const fullTitle = title ? `${title} · Keycap Archivist Mirror` : 'Keycap Archivist Mirror';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#1c1e24" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <ClientRouter />
    <script is:inline>
      // No-flash theme init: stored preference wins, else system preference.
      (() => {
        const stored = localStorage.getItem('ka-theme');
        const light =
          stored === 'light' ||
          (!stored && window.matchMedia('(prefers-color-scheme: light)').matches);
        if (light) document.documentElement.dataset.theme = 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <noscript>
      <span class="noscript-note">
        Browsing works without JavaScript; search and the image viewer need it.
      </span>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div class="kb-help">
      <div class="kb-help-panel" id="kb-help-panel" role="dialog" aria-label="Keyboard shortcuts" hidden>
        <p class="kb-help-title">Keyboard shortcuts</p>
        <dl>
          <dt><kbd>/</kbd></dt><dd>Search</dd>
          <dt><kbd>←</kbd><kbd>→</kbd><kbd>↑</kbd><kbd>↓</kbd></dt><dd>Move around a grid</dd>
          <dt><kbd>Enter</kbd></dt><dd>Open</dd>
          <dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>First / last card</dd>
          <dt><kbd>p</kbd></dt><dd>Pin a maker</dd>
          <dt><kbd>Esc</kbd></dt><dd>Close or clear</dd>
          <dt><kbd>?</kbd></dt><dd>This menu</dd>
        </dl>
      </div>
      <button
        id="kb-help-btn"
        aria-label="Keyboard shortcuts"
        aria-expanded="false"
        aria-controls="kb-help-panel"
      >?</button>
    </div>

    <script>
      import '../scripts/keyboard.js';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
  main:focus {
    outline: none;
  }

  .kb-help {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 45;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  #kb-help-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-panel);
    color: var(--ink-dim);
    font-size: 0.875rem;
    font-weight: 500;
    display: grid;
    place-items: center;
    transition: color var(--t), border-color var(--t);
  }
  #kb-help-btn:hover,
  #kb-help-btn[aria-expanded='true'] {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .kb-help-panel {
    background: var(--bg-panel);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px oklch(0.05 0 0 / 0.35);
    padding: 12px 14px;
    min-width: 220px;
  }
  .kb-help-title {
    margin: 0 0 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-mid);
  }
  .kb-help-panel dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    font-size: 0.75rem;
    color: var(--ink-mid);
  }
  .kb-help-panel dt {
    display: flex;
    gap: 3px;
    justify-content: flex-end;
  }
  .kb-help-panel dd {
    margin: 0;
    align-self: center;
  }
  @media (max-width: 700px), (hover: none) {
    .kb-help {
      display: none;
    }
  }
</style>
