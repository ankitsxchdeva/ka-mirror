---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import { withBase } from '../lib/catalog.js';

const { title, description, ogImage } = Astro.props;
const fullTitle = title ? `${title} · Keycap Archivist Mirror` : 'Keycap Archivist Mirror';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#1c1e24" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <ClientRouter />
    <script is:inline>
      // No-flash theme init: stored preference wins, else system preference.
      (() => {
        const stored = localStorage.getItem('ka-theme');
        const light =
          stored === 'light' ||
          (!stored && window.matchMedia('(prefers-color-scheme: light)').matches);
        if (light) document.documentElement.dataset.theme = 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <noscript>
      <span class="noscript-note">
        Browsing works without JavaScript; search and the image viewer need it.
      </span>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      import '../scripts/keyboard.js';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
